{
  "name": "signal-frontend",
  "version": "0.1.0",
  "description": "The Signal frontend is a Next.js app with React, Tailwind, and TypeScript that renders the chat interface, streams responses, and provides an accessible, responsive user experience.",
  "keywords": [
    "portfolio",
    "frontend",
    "nextjs",
    "react",
    "tailwind",
    "typescript",
    "chat",
    "ai",
    "signal"
  ],
  "author": "Anthony Bruno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonybruno/signal-frontend.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.513.0",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "24.0.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "abruno-dev-config": "^1.0.9",
    "commitlint": "^19.8.1",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ]
  }
}
