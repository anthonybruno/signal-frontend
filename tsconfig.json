{
  "extends": "abruno-dev-config/tsconfig",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": "./src",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
